<!DOCTYPE html>
<html lang="en">
  <%- include('partials/header', { title: typeof title !== 'undefined' ? title : 'Magnus' }) %>
<body>
  <header class="navbar">
    <div class="left-group">
      <%- include('partials/logo') %>
      <% if (typeof showNav === 'undefined' || showNav) { %>
        <%- include('partials/nav', { mode: typeof mode !== 'undefined' ? mode : null }) %>
      <% } %>
    </div>
    <%- include('partials/header_right') %>
  </header>

<div class="container">
    <div class="gridlayout">
        <aside class="panel left">
            <h2>Left Panel</h2>
        </aside>

        <main class="panel center">
            <h2>Center Panel</h2>
        </main>

        <aside class="panel right">
            <h2>Right Panel</h2>
        </aside>
    </div>
</div>

  <% if (typeof pageData !== 'undefined' && pageData) { %>
  <script>
    window.MAGNUS_PAGE_DATA = <%- JSON.stringify(pageData) %>;
  </script>
  <% } %>

  <% if (typeof pageScript !== 'undefined' && pageScript) { %>
    <script src="<%= pageScript %>?v=<%= assetVersion(pageScript) %>"></script>
  <% } %>

  <%- include('partials/error') %>

</body>
</html>
   

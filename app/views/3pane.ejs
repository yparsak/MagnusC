<!DOCTYPE html>
<html lang="en">
  <%- include('partials/header', { title: typeof title !== 'undefined' ? title : 'Magnus' }) %>
<body>
  <header class="navbar">
    <div class="left-group">
      <%- include('partials/logo') %>
      <% if (typeof showNav === 'undefined' || showNav) { %>
        <%- include('partials/nav', { mode: typeof mode !== 'undefined' ? mode : null }) %>
      <% } %>
    </div>
    <%- include('partials/header_right') %>
  </header>

  <div class="layout-three">
    <aside class="left-panel">
    </aside>
    <main class="center-panel">
        <div class="card">
            <div class="tabs">
                <div class="tab active">Archives</div>
            </div>
            <table class="table">
                <thead>
                <tr>
                    <th>Player</th>
                    <th>Time</th>
                    <th>Rated</th>
                    <th>Color</th>
                </tr>
                </thead>
                <tbody>
                <tr>
                    <td>Anonymous</td>
                    <td>1+2</td>
                    <td>Casual</td>
                    <td>Random</td>
                </tr>
                <tr>
                    <td>Anonymous</td>
                    <td>15+10</td>
                    <td>Rated</td>
                    <td>Random</td>
                </tr>
                </tbody>
            </table>
        </div>
    </main>
    <aside class="right-panel">
    </aside>
  </div>

  <% if (typeof pageData !== 'undefined' && pageData) { %>
  <script>
    window.MAGNUS_PAGE_DATA = <%- JSON.stringify(pageData) %>;
  </script>
  <% } %>

  <% if (typeof pageScript !== 'undefined' && pageScript) { %>
    <script src="<%= pageScript %>?v=<%= assetVersion(pageScript) %>"></script>
  <% } %>

  <%- include('partials/error') %>

</body>
</html>
   
